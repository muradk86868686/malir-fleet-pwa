{
  "name": "malir-fleet-gate-exit-pwa",
  "version": "1.0.0",
  "description": "Mobile-First Progressive Web App for Fleet Gate-Exit Tracking (District Malir - Petroleum & EV Vehicles)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:css": "tailwindcss -i css/input.css -o css/style.css --minify",
    "watch:css": "tailwindcss -i css/input.css -o css/style.css --watch",
    "test": "node tests/verify.js"
  },
  "keywords": [
    "pwa",
    "fleet-management",
    "google-apps-script",
    "district-malir",
    "gate-exit",
    "ev-fleet",
    "offline-first"
  ],
  "author": "District Malir Fleet Operations",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.6.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8"
  }
}
